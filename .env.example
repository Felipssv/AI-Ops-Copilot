# Configuração do Ambiente — AI Ops Copilot (Execução 100% Local)

# Ambiente (development | test)
APP_ENV=development
LOG_LEVEL=INFO

# Diretórios de Persistência Local
DATA_DIR=data
ARTIFACTS_DIR=artifacts
SQLITE_DB_PATH=data/ai_ops_copilot.db

# Parâmetros Padrão de Domínio e Dados
DEFAULT_RANDOM_SEED=42
DEFAULT_LATE_TOLERANCE_MINUTES=5
DEFAULT_SYNTHETIC_ORDERS=10000

# API Backend (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000

# Runtime Local de LLM (Ollama — Estritamente Local)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_CALLS=3

